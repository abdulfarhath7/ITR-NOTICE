# Portal credentials are NOT here on purpose - type them into the dashboard.
# They stay in server memory only and are forgotten when the server stops.

# Password for the dashboard itself. Leave empty ONLY on localhost - if this
# is empty and the port is reachable, anyone can read your notices.
APP_PASSWORD=

ANTHROPIC_API_KEY=sk-ant-add-later

# false = show the browser window (recommended until the scraper is verified)
HEADLESS=false

# The pause between browser actions is the dashboard's Slow / Fast / Extreme
# buttons, not a setting here - it can be changed mid-sync.

# Seconds to keep the browser open after a failure so you can read the screen. 0 = close at once.
HOLD_ON_ERROR=15
