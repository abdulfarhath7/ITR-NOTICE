{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src"],
  // Kept on disk (they are part of the lib layer), kept out of the typecheck:
  // all three belong to the deleted loopback-HTTP design and cannot compile
  // against this tree - ws.ts talks to a websocket that no longer exists,
  // utils.ts wants Tailwind's clsx/tailwind-merge, files.ts wants the
  // dialog/fs plugins the capability file does not grant. See NOTES.md.
  "exclude": ["src/lib/ws.ts", "src/lib/utils.ts", "src/lib/files.ts"]
}
