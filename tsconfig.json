{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  // Left over from the Tailwind/shadcn UI: these still import the "@/" alias
  // and plugins this app no longer has, so `tsc` fails on them even though
  // nothing bundles them. Delete the trees and this block goes away - see the
  // dead-files table in NOTES.md.
  "exclude": ["src/app", "src/features", "src/hooks", "src/components/ui",
              "src/lib/ws.ts", "src/lib/files.ts", "src/lib/secrets.ts",
              "src/lib/runtime.ts", "src/lib/utils.ts", "src/lib/format.ts",
              "src/styles/globals.css"]
}
